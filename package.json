{
  "name": "book-fair-testing",
  "version": "1.0.0",
  "description": "API testing for Book Fair Management System",
  "scripts": {
    "test:api": "newman run postman_collection.json --env-var baseUrl=http://localhost:3001/api --reporters cli,json --reporter-json-export newman-results.json",
    "test:api:verbose": "newman run postman_collection.json --env-var baseUrl=http://localhost:3001/api --verbose",
    "test:auth": "newman run postman_collection.json --folder Auth",
    "test:users": "newman run postman_collection.json --folder Users",
    "test:publishers": "newman run postman_collection.json --folder Publishers",
    "test:books": "newman run postman_collection.json --folder Books",
    "test:lists": "newman run postman_collection.json --folder Lists",
    "test:orders": "newman run postman_collection.json --folder Orders"
  },
  "devDependencies": {
    "newman": "^6.0.0"
  }
}
