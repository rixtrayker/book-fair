        {
          "name": "Update Order Status",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "url": "{{baseUrl}}/orders/{{orderId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shipping_status\": \"shipped\"\n}"
            }
          }
        }
      ]
    }
  ]
}
